# ===== Agrega/ajusta esto en backend/.env =====
APP_NAME="Plataforma Reportes"
APP_ENV=local
APP_DEBUG=true                      # false en producción
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173  # usado en el enlace de "recuperar contraseña"
APP_LOCALE=es
APP_TIMEZONE=America/Mexico_City

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=plataforma_reportes
DB_USERNAME=reportes_app            # usuario propio, NO root
DB_PASSWORD=cambia_esto

# Sesión (Sanctum SPA con cookies)
SESSION_DRIVER=database
SESSION_LIFETIME=120                # minutos de inactividad
SESSION_ENCRYPT=true
SESSION_DOMAIN=localhost            # prod: .tuempresa.com
SESSION_SECURE_COOKIE=false         # prod: true (HTTPS)
SESSION_SAME_SITE=lax
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173   # prod: app.tuempresa.com

CACHE_STORE=database                # soporta los locks del ETL
QUEUE_CONNECTION=database

# Correo (recuperación de contraseña). Los secretos viven aquí, nunca en la BD.
MAIL_MAILER=log                     # en desarrollo escribe el correo en storage/logs
MAIL_HOST=smtp.tu-proveedor.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-responder@tuempresa.com"
MAIL_FROM_NAME="${APP_NAME}"

# Reglas de negocio (config/reportes.php)
NUM_EMPLEADO_PREFIJO=MSI
NUM_EMPLEADO_DIGITOS=6              # MSI000001 (hasta 999,999 empleados)
LOGIN_MAX_INTENTOS=5
LOGIN_MINUTOS_BLOQUEO=15
